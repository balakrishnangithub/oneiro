# Copy this file to key.properties (same folder) and fill in your values.
# key.properties and the keystore file are git-ignored — NEVER commit them.
#
# Generate the keystore once with:
#   keytool -genkey -v -keystore oneiro-upload-key.jks -keyalg RSA -keysize 2048 -validity 10950 -alias upload
# then place oneiro-upload-key.jks in this folder (android/) and edit below.

storeFile=oneiro-upload-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
